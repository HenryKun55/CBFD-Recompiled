+//---------------------------------------------------------
+// Semaphore (PS Vita: the kernel's semaphores)
+//---------------------------------------------------------
+class Semaphore
+{
+private:
+	SceUID m_sema;
+
+	Semaphore(const Semaphore& other) MOODYCAMEL_DELETE_FUNCTION;
+	Semaphore& operator=(const Semaphore& other) MOODYCAMEL_DELETE_FUNCTION;
+
+public:
+	Semaphore(int initialCount = 0) : m_sema()
+	{
+		assert(initialCount >= 0);
+		m_sema = sceKernelCreateSema("moodycamel", 0, initialCount, 0x7FFFFFFF, nullptr);
+		assert(m_sema >= 0);
+	}
+
+	~Semaphore()
+	{
+		sceKernelDeleteSema(m_sema);
+	}
+
+	bool wait()
+	{
+		return sceKernelWaitSema(m_sema, 1, nullptr) == 0;
+	}
+
+	bool try_wait()
+	{
+		return sceKernelPollSema(m_sema, 1) == 0;
+	}
+
+	bool timed_wait(std::uint64_t usecs)
+	{
+		SceUInt timeout = (SceUInt)(usecs > 0xFFFFFFFFull ? 0xFFFFFFFFull : usecs);
+		return sceKernelWaitSema(m_sema, 1, &timeout) == 0;
+	}
+
+	void signal()
+	{
+		sceKernelSignalSema(m_sema, 1);
+	}
+
+	void signal(int count)
+	{
+		if (count > 0)
+			sceKernelSignalSema(m_sema, count);
+	}
