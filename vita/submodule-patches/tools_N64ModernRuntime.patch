     return temp_file_out;
 }
 
+#if defined(__vita__)
+#include <cstdio>
+#include <vector>
+
+// newlib's std::filesystem::copy_file can't overwrite a file on the Vita: copy by hand.
+static bool copy_file_contents(const std::filesystem::path& from, const std::filesystem::path& to) {
+    FILE* in = std::fopen(from.c_str(), "rb");
+    if (in == nullptr) {
+        return false;
+    }
+    std::vector<char> data;
+    char buffer[4096];
+    size_t n;
+    while ((n = std::fread(buffer, 1, sizeof(buffer), in)) > 0) {
+        data.insert(data.end(), buffer, buffer + n);
+    }
+    std::fclose(in);
+    std::remove(to.c_str());
+    FILE* out = std::fopen(to.c_str(), "wb");
+    if (out == nullptr) {
+        return false;
+    }
+    const bool ok = std::fwrite(data.data(), 1, data.size(), out) == data.size();
+    return (std::fclose(out) == 0) && ok;
+}
+
+bool recomp::finalize_output_file_with_backup(const std::filesystem::path& filepath) {
+    std::filesystem::path backup_path{filepath};
+    backup_path += backup_suffix;
+    std::filesystem::path temp_path{filepath};
+    temp_path += temp_suffix;
+
+    std::error_code ec;
+    if (std::filesystem::exists(filepath, ec) && !copy_file_contents(filepath, backup_path)) {
+        return false;
+    }
+    if (!copy_file_contents(temp_path, filepath)) {
+        return false;
+    }
+    std::remove(temp_path.c_str());
+    return true;
+}
+#else
 bool recomp::finalize_output_file_with_backup(const std::filesystem::path& filepath) {
